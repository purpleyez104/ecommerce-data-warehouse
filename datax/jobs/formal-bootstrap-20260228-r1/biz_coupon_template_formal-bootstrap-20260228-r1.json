{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "${MYSQL_USER}",
            "password": "${MYSQL_PASSWORD}",
            "connection": [
              {
                "jdbcUrl": [
                  "${MYSQL_JDBC_URL}"
                ],
                "querySql": [
                  "SELECT\n  `template_id`,\n  `template_code`,\n  `template_name`,\n  `face_value_cents`,\n  `min_spend_cents`,\n  `valid_from`,\n  `valid_to`,\n  `issue_limit`,\n  `template_status`,\n  `created_at`,\n  `updated_at`,\n  DATE_FORMAT(`created_at`, '%Y-%m-%d') AS `business_date`,\n  '2026-10-17 20:35:00' AS `extract_time`,\n  'formal-bootstrap-20260228-r1' AS `batch_id`,\n  'biz_coupon_template' AS `source_table`\nFROM `biz_coupon_template`\nWHERE 1 = 1"
                ]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "${HDFS_DEFAULT_FS}",
            "path": "/warehouse/ecommerce/ods/.staging/ods_coupon_template/batch_id=formal-bootstrap-20260228-r1",
            "fileName": "biz_coupon_template_formal-bootstrap-20260228-r1",
            "fileType": "orc",
            "compress": "SNAPPY",
            "fieldDelimiter": "\u0001",
            "writeMode": "nonConflict",
            "column": [
              {
                "name": "template_id",
                "type": "BIGINT"
              },
              {
                "name": "template_code",
                "type": "STRING"
              },
              {
                "name": "template_name",
                "type": "STRING"
              },
              {
                "name": "face_value_cents",
                "type": "BIGINT"
              },
              {
                "name": "min_spend_cents",
                "type": "BIGINT"
              },
              {
                "name": "valid_from",
                "type": "TIMESTAMP"
              },
              {
                "name": "valid_to",
                "type": "TIMESTAMP"
              },
              {
                "name": "issue_limit",
                "type": "INT"
              },
              {
                "name": "template_status",
                "type": "STRING"
              },
              {
                "name": "created_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "updated_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "business_date",
                "type": "STRING"
              },
              {
                "name": "extract_time",
                "type": "STRING"
              },
              {
                "name": "batch_id",
                "type": "STRING"
              },
              {
                "name": "source_table",
                "type": "STRING"
              }
            ]
          }
        }
      }
    ]
  }
}
