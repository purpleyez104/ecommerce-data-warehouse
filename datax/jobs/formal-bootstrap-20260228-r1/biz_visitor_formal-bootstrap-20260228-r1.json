{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "${MYSQL_USER}",
            "password": "${MYSQL_PASSWORD}",
            "connection": [
              {
                "jdbcUrl": [
                  "${MYSQL_JDBC_URL}"
                ],
                "querySql": [
                  "SELECT\n  `visitor_id`,\n  `visitor_key`,\n  `first_seen_at`,\n  `last_seen_at`,\n  `created_at`,\n  `updated_at`,\n  DATE_FORMAT(`first_seen_at`, '%Y-%m-%d') AS `business_date`,\n  '2026-10-17 20:35:00' AS `extract_time`,\n  'formal-bootstrap-20260228-r1' AS `batch_id`,\n  'biz_visitor' AS `source_table`\nFROM `biz_visitor`\nWHERE 1 = 1"
                ]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "${HDFS_DEFAULT_FS}",
            "path": "/warehouse/ecommerce/ods/.staging/ods_visitor/batch_id=formal-bootstrap-20260228-r1",
            "fileName": "biz_visitor_formal-bootstrap-20260228-r1",
            "fileType": "orc",
            "compress": "SNAPPY",
            "fieldDelimiter": "\u0001",
            "writeMode": "nonConflict",
            "column": [
              {
                "name": "visitor_id",
                "type": "BIGINT"
              },
              {
                "name": "visitor_key",
                "type": "STRING"
              },
              {
                "name": "first_seen_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "last_seen_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "created_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "updated_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "business_date",
                "type": "STRING"
              },
              {
                "name": "extract_time",
                "type": "STRING"
              },
              {
                "name": "batch_id",
                "type": "STRING"
              },
              {
                "name": "source_table",
                "type": "STRING"
              }
            ]
          }
        }
      }
    ]
  }
}
