{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "${MYSQL_USER}",
            "password": "${MYSQL_PASSWORD}",
            "connection": [
              {
                "jdbcUrl": [
                  "${MYSQL_JDBC_URL}"
                ],
                "querySql": [
                  "SELECT\n  `refund_event_id`,\n  `event_key`,\n  `refund_request_id`,\n  `refund_txn_id`,\n  `event_type`,\n  `from_status`,\n  `to_status`,\n  `occurred_at`,\n  `recorded_at`,\n  DATE_FORMAT(`occurred_at`, '%Y-%m-%d') AS `business_date`,\n  '2026-10-17 20:35:00' AS `extract_time`,\n  'formal-bootstrap-20260228-r1' AS `batch_id`,\n  'biz_refund_event' AS `source_table`\nFROM `biz_refund_event`\nWHERE 1 = 1"
                ]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "${HDFS_DEFAULT_FS}",
            "path": "/warehouse/ecommerce/ods/.staging/ods_refund_event/batch_id=formal-bootstrap-20260228-r1",
            "fileName": "biz_refund_event_formal-bootstrap-20260228-r1",
            "fileType": "orc",
            "compress": "SNAPPY",
            "fieldDelimiter": "\u0001",
            "writeMode": "nonConflict",
            "column": [
              {
                "name": "refund_event_id",
                "type": "BIGINT"
              },
              {
                "name": "event_key",
                "type": "STRING"
              },
              {
                "name": "refund_request_id",
                "type": "BIGINT"
              },
              {
                "name": "refund_txn_id",
                "type": "BIGINT"
              },
              {
                "name": "event_type",
                "type": "STRING"
              },
              {
                "name": "from_status",
                "type": "STRING"
              },
              {
                "name": "to_status",
                "type": "STRING"
              },
              {
                "name": "occurred_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "recorded_at",
                "type": "TIMESTAMP"
              },
              {
                "name": "business_date",
                "type": "STRING"
              },
              {
                "name": "extract_time",
                "type": "STRING"
              },
              {
                "name": "batch_id",
                "type": "STRING"
              },
              {
                "name": "source_table",
                "type": "STRING"
              }
            ]
          }
        }
      }
    ]
  }
}
