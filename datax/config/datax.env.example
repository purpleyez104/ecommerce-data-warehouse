# =========================
# DataX Runtime
# =========================

DATAX_HOME=/data/module/datax-current


# =========================
# MySQL
# =========================

MYSQL_HOST=hadoop201
MYSQL_PORT=3306

MYSQL_DATABASE=ecommerce_oltp

MYSQL_USER=datax_reader

# 不提交真实密码
MYSQL_PASSWORD=


MYSQL_JDBC_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai


# =========================
# HDFS
# =========================

HDFS_DEFAULT_FS=hdfs://hadoop201:8020

# DataX 只写批次隔离的 staging 路径；通过验证后由独立 Publish 入口发布。
ODS_STAGE_ROOT=/warehouse/ecommerce/ods/.staging


# =========================
# Project Runtime
# =========================

PROJECT_HOME=/data/projects/ecommerce-data-warehouse

# 只能设置为 ${PROJECT_HOME}/runtime/datax/jobs 或其子目录；生成器拒绝越界和符号链接逃逸。
DATAX_JOB_DIR=${PROJECT_HOME}/runtime/datax/jobs

DATAX_LOG_DIR=${PROJECT_HOME}/runtime/datax/logs
